#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# apm — AI Package Manager CLI
# Inject skills từ github.com/phamtanphat/skills vào dự án
#
# COMMANDS:
#   apm init          — Khởi tạo apm.yml cho dự án hiện tại
#   apm inject        — Inject skills vào tất cả IDE được detect
#   apm inject --ide cursor  — Inject vào IDE cụ thể
#   apm update        — Cập nhật skills repo
#   apm status        — Xem trạng thái
#   apm list          — Liệt kê skills có sẵn
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

# ─── Config ───────────────────────────────────────────────────
SKILLS_DIR="${SKILLS_DIR:-$HOME/Desktop/skills}"
APM_YML="${APM_YML:-$PWD/apm.yml}"
SKILLS_REPO="https://github.com/phamtanphat/skills.git"

# ─── Colors ───────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

info()    { echo -e "${BLUE}ℹ${RESET}  $*"; }
success() { echo -e "${GREEN}✓${RESET}  $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET}  $*"; }
error()   { echo -e "${RED}✗${RESET}  $*" >&2; exit 1; }
dim()     { echo -e "${DIM}   $*${RESET}"; }

# ═══════════════════════════════════════════════════════════════
# DETECT: Project Type
# ═══════════════════════════════════════════════════════════════
detect_project_type() {
  local dir="${1:-$PWD}"
  
  # Flutter / Dart
  if [ -f "$dir/pubspec.yaml" ]; then
    echo "flutter"
  # Python
  elif [ -f "$dir/pyproject.toml" ] || [ -f "$dir/requirements.txt" ] || \
       [ -f "$dir/setup.py" ] || [ -f "$dir/Pipfile" ]; then
    echo "python"
  # JavaScript / TypeScript
  elif [ -f "$dir/package.json" ]; then
    if grep -q '"next"' "$dir/package.json" 2>/dev/null; then
      echo "nextjs"
    elif grep -q '"react"' "$dir/package.json" 2>/dev/null; then
      echo "react"
    else
      echo "javascript"
    fi
  # Go
  elif [ -f "$dir/go.mod" ]; then
    echo "go"
  # Rust
  elif [ -f "$dir/Cargo.toml" ]; then
    echo "rust"
  # Generic
  else
    echo "generic"
  fi
}

# ═══════════════════════════════════════════════════════════════
# DETECT: IDEs đang được dùng trong dự án/máy
# ═══════════════════════════════════════════════════════════════
detect_ides() {
  local ides=()
  
  # Claude / Antigravity (CLAUDE.md)
  if command -v claude &>/dev/null || [ -f "$PWD/CLAUDE.md" ]; then
    ides+=("claude")
  fi
  
  # Cursor (.cursor/ directory hoặc .cursorrules)
  if [ -d "$HOME/.cursor" ] || [ -f "$PWD/.cursorrules" ] || [ -d "$PWD/.cursor" ]; then
    ides+=("cursor")
  fi
  
  # Codex / OpenAI (codex.md)
  if command -v codex &>/dev/null || [ -f "$PWD/codex.md" ]; then
    ides+=("codex")
  fi
  
  # Windsurf / Codeium
  if [ -d "$HOME/.codeium" ] || [ -f "$PWD/.windsurfrules" ]; then
    ides+=("windsurf")
  fi
  
  # GitHub Copilot (.github/copilot-instructions.md)
  if [ -f "$PWD/.github/copilot-instructions.md" ] || [ -d "$PWD/.github" ]; then
    ides+=("copilot")
  fi
  
  # VSCode (mặc định nếu .vscode/ tồn tại)
  if [ -d "$PWD/.vscode" ]; then
    ides+=("vscode")
  fi
  
  # Nếu không detect được gì, mặc định dùng claude + cursor
  if [ ${#ides[@]} -eq 0 ]; then
    ides+=("claude" "cursor")
  fi
  
  echo "${ides[@]}"
}

# ═══════════════════════════════════════════════════════════════
# BUILD: Compile skills thành 1 markdown string
# ═══════════════════════════════════════════════════════════════
build_skills_content() {
  local project_type="$1"
  local template="$SKILLS_DIR/templates/${project_type}-project/apm.yml"
  
  # Dùng template theo loại project nếu có, không thì dùng global
  if [ ! -f "$template" ]; then
    template="$SKILLS_DIR/apm.yml"
  fi
  
  echo "# AI Skills Configuration"
  echo "# Generated by APM — github.com/phamtanphat/skills"
  echo "# Project type: $project_type"
  echo ""
  
  # Parse apm.yml và đọc nội dung các skill files
  # Dùng grep để extract path lines (simple YAML parsing)
  local in_skills=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^skills: ]]; then
      in_skills=true
      continue
    fi
    if [[ "$line" =~ ^mcpServers: ]]; then
      in_skills=false
      continue
    fi
    
    if $in_skills && [[ "$line" =~ path:\ (.+) ]]; then
      local skill_path="${BASH_REMATCH[1]}"
      # Expand ~ và resolve path
      skill_path="${skill_path/#\~/$HOME}"
      # Thử tìm file trong SKILLS_DIR nếu path là relative
      if [[ "$skill_path" == ./* ]]; then
        skill_path="$SKILLS_DIR/${skill_path:2}"
      fi
      
      if [ -f "$skill_path" ]; then
        echo ""
        echo "---"
        cat "$skill_path"
        echo ""
      fi
    fi
  done < "$template"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Claude / Antigravity — CLAUDE.md
# ═══════════════════════════════════════════════════════════════
inject_claude() {
  local project_type="$1"
  local target="$PWD/CLAUDE.md"
  
  info "Đang inject vào Claude (CLAUDE.md)..."
  
  cat > "$target" << CLAUDE_EOF
# Claude AI Instructions

<!-- APM_GENERATED — Đừng sửa tay, dùng: apm inject -->
<!-- Skills source: github.com/phamtanphat/skills -->
<!-- Project type: $project_type -->
<!-- Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ") -->

$(build_skills_content "$project_type")

---

## MCP Configuration

Xem file \`apm.yml\` để cấu hình MCP servers cho dự án này.

CLAUDE_EOF

  success "Claude: $target"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Cursor — .cursorrules
# ═══════════════════════════════════════════════════════════════
inject_cursor() {
  local project_type="$1"
  local target="$PWD/.cursorrules"
  
  info "Đang inject vào Cursor (.cursorrules)..."
  
  cat > "$target" << CURSOR_EOF
# Cursor AI Rules
# APM_GENERATED — Đừng sửa tay, dùng: apm inject
# Skills source: github.com/phamtanphat/skills
# Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ")

$(build_skills_content "$project_type")
CURSOR_EOF

  success "Cursor: $target"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Codex — codex.md (OpenAI Codex)
# ═══════════════════════════════════════════════════════════════
inject_codex() {
  local project_type="$1"
  local target="$PWD/codex.md"
  
  info "Đang inject vào Codex (codex.md)..."
  
  cat > "$target" << CODEX_EOF
# Codex AI Instructions
<!-- APM_GENERATED — Đừng sửa tay, dùng: apm inject -->
<!-- Skills source: github.com/phamtanphat/skills -->
<!-- Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ") -->

$(build_skills_content "$project_type")
CODEX_EOF

  success "Codex: $target"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Windsurf — .windsurfrules
# ═══════════════════════════════════════════════════════════════
inject_windsurf() {
  local project_type="$1"
  local target="$PWD/.windsurfrules"
  
  info "Đang inject vào Windsurf (.windsurfrules)..."
  
  cat > "$target" << WINDSURF_EOF
# Windsurf AI Rules
# APM_GENERATED — Đừng sửa tay, dùng: apm inject
# Skills source: github.com/phamtanphat/skills
# Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ")

$(build_skills_content "$project_type")
WINDSURF_EOF

  success "Windsurf: $target"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: GitHub Copilot — .github/copilot-instructions.md
# ═══════════════════════════════════════════════════════════════
inject_copilot() {
  local project_type="$1"
  local target="$PWD/.github/copilot-instructions.md"
  
  info "Đang inject vào GitHub Copilot..."
  mkdir -p "$PWD/.github"
  
  cat > "$target" << COPILOT_EOF
# GitHub Copilot Instructions
<!-- APM_GENERATED — Đừng sửa tay, dùng: apm inject -->
<!-- Skills source: github.com/phamtanphat/skills -->
<!-- Generated: $(date -u +"%Y-%m-%dT%H:%M:%SZ") -->

$(build_skills_content "$project_type")
COPILOT_EOF

  success "Copilot: $target"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: VSCode — .vscode/settings.json (GitHub Copilot instructions)
# ═══════════════════════════════════════════════════════════════
inject_vscode() {
  local project_type="$1"
  # VSCode dùng Copilot nên reuse copilot inject
  inject_copilot "$project_type"
  success "VSCode: dùng .github/copilot-instructions.md"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm init
# ═══════════════════════════════════════════════════════════════
cmd_init() {
  echo -e "\n${BOLD}${CYAN}APM Init${RESET} — Khởi tạo cho dự án\n"
  
  # Check skills repo
  if [ ! -d "$SKILLS_DIR" ]; then
    error "Skills repo chưa được cài. Chạy: curl -fsSL https://raw.githubusercontent.com/phamtanphat/skills/main/install.sh | bash"
  fi
  
  local project_type
  project_type=$(detect_project_type "$PWD")
  info "Loại dự án: ${BOLD}$project_type${RESET}"
  
  local template="$SKILLS_DIR/templates/${project_type}-project/apm.yml"
  
  if [ -f "$APM_YML" ]; then
    warn "apm.yml đã tồn tại. Dùng 'apm inject' để cập nhật skills vào IDE."
    return 0
  fi
  
  # Copy template
  if [ -f "$template" ]; then
    cp "$template" "$APM_YML"
    # Replace project name
    local proj_name
    proj_name=$(basename "$PWD")
    sed -i.bak "s/my-${project_type}-app/$proj_name/g" "$APM_YML" 2>/dev/null || \
    sed -i "s/my-${project_type}-app/$proj_name/g" "$APM_YML"
    rm -f "$APM_YML.bak"
    success "Đã tạo apm.yml từ template '${project_type}'"
  else
    # Generic template
    cat > "$APM_YML" << GENERIC_EOF
# apm.yml — $(basename "$PWD")
# Generated by APM — github.com/phamtanphat/skills

name: $(basename "$PWD")
version: 1.0.0

skills:
  - name: git-workflow
    description: Git workflow chuẩn
    path: $SKILLS_DIR/skills/workflow/git-workflow.md
    activate:
      always: true

  - name: clean-architecture
    description: Clean Architecture guide
    path: $SKILLS_DIR/skills/architecture/clean-architecture.md
    activate:
      always: true

mcpServers:
  serena:
    command: uvx
    args:
      - "--from"
      - "git+https://github.com/oraios/serena"
      - "serena"
      - "start-mcp-server"
    transport: stdio

  context7:
    command: npx
    args: ["-y", "@upstash/context7-mcp"]
    transport: stdio
    env:
      CONTEXT7_API_KEY: "ctx7sk-31f118e9-1ca9-4dfc-8a59-4cd58ec0a630"
GENERIC_EOF
    success "Đã tạo apm.yml (generic template)"
  fi
  
  echo ""
  info "Bước tiếp theo:"
  dim "1. Xem và chỉnh apm.yml nếu cần"
  dim "2. Chạy: apm inject"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm inject
# ═══════════════════════════════════════════════════════════════
cmd_inject() {
  local target_ide="${1:-}"
  
  echo -e "\n${BOLD}${CYAN}APM Inject${RESET} — Inject skills vào IDE\n"
  
  # Check skills repo
  if [ ! -d "$SKILLS_DIR" ]; then
    error "Skills repo chưa được cài. Chạy install.sh trước."
  fi
  
  local project_type
  project_type=$(detect_project_type "$PWD")
  info "Loại dự án: ${BOLD}$project_type${RESET}"
  
  # Detect hoặc dùng IDE được chỉ định
  local ides
  if [ -n "$target_ide" ]; then
    ides=("$target_ide")
  else
    read -ra ides <<< "$(detect_ides)"
    info "IDEs được detect: ${BOLD}${ides[*]}${RESET}"
  fi
  
  echo ""
  
  for ide in "${ides[@]}"; do
    case "$ide" in
      claude|antigravity) inject_claude "$project_type" ;;
      cursor)             inject_cursor "$project_type" ;;
      codex)              inject_codex "$project_type" ;;
      windsurf)           inject_windsurf "$project_type" ;;
      copilot)            inject_copilot "$project_type" ;;
      vscode)             inject_vscode "$project_type" ;;
      *)                  warn "IDE '$ide' không được hỗ trợ. Thử: claude, cursor, codex, windsurf, copilot" ;;
    esac
  done
  
  echo ""
  success "Inject hoàn thành! Skills đã sẵn sàng trong dự án."
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm update
# ═══════════════════════════════════════════════════════════════
cmd_update() {
  echo -e "\n${BOLD}${CYAN}APM Update${RESET} — Cập nhật Skills Repository\n"
  
  if [ ! -d "$SKILLS_DIR/.git" ]; then
    error "Skills repo chưa được cài tại $SKILLS_DIR"
  fi
  
  info "Đang pull từ $SKILLS_REPO..."
  git -C "$SKILLS_DIR" pull origin main
  success "Đã cập nhật! Chạy 'apm inject' để áp dụng."
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm status
# ═══════════════════════════════════════════════════════════════
cmd_status() {
  echo -e "\n${BOLD}${CYAN}APM Status${RESET}\n"
  
  # Skills repo
  if [ -d "$SKILLS_DIR/.git" ]; then
    local version
    version=$(git -C "$SKILLS_DIR" log --oneline -1 2>/dev/null | cut -c1-7)
    success "Skills repo: $SKILLS_DIR ${DIM}(commit: $version)${RESET}"
  else
    warn "Skills repo chưa cài tại $SKILLS_DIR"
  fi
  
  # Project type
  local project_type
  project_type=$(detect_project_type "$PWD")
  info "Project type: ${BOLD}$project_type${RESET}"
  
  # apm.yml
  if [ -f "$APM_YML" ]; then
    success "apm.yml: $APM_YML"
  else
    warn "Chưa có apm.yml — chạy: apm init"
  fi
  
  # Detect files đã inject
  echo ""
  echo -e "  ${BOLD}IDE Files:${RESET}"
  local files=(
    "CLAUDE.md:Claude/Antigravity"
    ".cursorrules:Cursor"
    "codex.md:Codex"
    ".windsurfrules:Windsurf"
    ".github/copilot-instructions.md:GitHub Copilot"
  )
  for entry in "${files[@]}"; do
    local file="${entry%%:*}"
    local label="${entry##*:}"
    if [ -f "$PWD/$file" ]; then
      if grep -q "APM_GENERATED" "$PWD/$file" 2>/dev/null; then
        success "$label: $file ${DIM}(apm managed)${RESET}"
      else
        info "$label: $file ${DIM}(manual)${RESET}"
      fi
    else
      dim "$label: —"
    fi
  done
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm list
# ═══════════════════════════════════════════════════════════════
cmd_list() {
  echo -e "\n${BOLD}${CYAN}APM Skills${RESET} — Có sẵn trong $SKILLS_DIR\n"
  
  if [ ! -d "$SKILLS_DIR/skills" ]; then
    error "Skills repo chưa được cài."
  fi
  
  find "$SKILLS_DIR/skills" -name "*.md" | sort | while read -r f; do
    local rel="${f#$SKILLS_DIR/}"
    echo -e "  ${CYAN}•${RESET} $rel"
  done
  echo ""
  echo -e "  ${BOLD}Templates:${RESET}"
  find "$SKILLS_DIR/templates" -name "apm.yml" | sort | while read -r f; do
    local template_name
    template_name=$(basename "$(dirname "$f")")
    echo -e "  ${GREEN}→${RESET} $template_name"
  done
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm help
# ═══════════════════════════════════════════════════════════════
cmd_help() {
  echo ""
  echo -e "${BOLD}${CYAN}APM — AI Package Manager${RESET}"
  echo -e "${DIM}github.com/phamtanphat/skills${RESET}"
  echo ""
  echo -e "${BOLD}USAGE:${RESET}"
  echo -e "  apm ${CYAN}<command>${RESET} [options]"
  echo ""
  echo -e "${BOLD}COMMANDS:${RESET}"
  echo -e "  ${CYAN}init${RESET}              Tạo apm.yml cho dự án (auto-detect project type)"
  echo -e "  ${CYAN}inject${RESET}            Inject skills vào tất cả IDE được detect"
  echo -e "  ${CYAN}inject --ide <name>${RESET}  Inject vào IDE cụ thể"
  echo -e "  ${CYAN}update${RESET}            Cập nhật skills repository"
  echo -e "  ${CYAN}status${RESET}            Xem trạng thái dự án hiện tại"
  echo -e "  ${CYAN}list${RESET}              Liệt kê tất cả skills có sẵn"
  echo ""
  echo -e "${BOLD}IDE SUPPORT:${RESET}"
  echo -e "  ${GREEN}claude${RESET}    → CLAUDE.md"
  echo -e "  ${GREEN}cursor${RESET}    → .cursorrules"
  echo -e "  ${GREEN}codex${RESET}     → codex.md"
  echo -e "  ${GREEN}windsurf${RESET}  → .windsurfrules"
  echo -e "  ${GREEN}copilot${RESET}   → .github/copilot-instructions.md"
  echo ""
  echo -e "${BOLD}EXAMPLES:${RESET}"
  echo -e "  ${DIM}# Dự án mới:${RESET}"
  echo -e "  apm init && apm inject"
  echo ""
  echo -e "  ${DIM}# Chỉ inject vào Cursor:${RESET}"
  echo -e "  apm inject --ide cursor"
  echo ""
  echo -e "  ${DIM}# Inject vào tất cả IDE:${RESET}"
  echo -e "  apm inject --ide claude --ide cursor --ide codex"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# MAIN — Parse commands
# ═══════════════════════════════════════════════════════════════
COMMAND="${1:-help}"

case "$COMMAND" in
  init)
    cmd_init
    ;;
  inject)
    shift || true
    # Parse --ide flags
    IDE_ARG=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --ide) IDE_ARG="${2:-}"; shift 2 ;;
        *)     shift ;;
      esac
    done
    cmd_inject "$IDE_ARG"
    ;;
  update)
    cmd_update
    ;;
  status)
    cmd_status
    ;;
  list)
    cmd_list
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    error "Command '$COMMAND' không tồn tại. Dùng: apm help"
    ;;
esac
