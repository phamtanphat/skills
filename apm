#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# apm — AI Package Manager CLI
# Inject skills từ github.com/phamtanphat/skills vào dự án
#
# COMMANDS:
#   apm init          — Khởi tạo apm.yml cho dự án hiện tại
#   apm inject        — Inject skills vào tất cả IDE được detect
#   apm inject --ide cursor  — Inject vào IDE cụ thể
#   apm update        — Cập nhật skills repo
#   apm status        — Xem trạng thái
#   apm list          — Liệt kê skills có sẵn
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

# ─── Config ───────────────────────────────────────────────────
SKILLS_DIR="${SKILLS_DIR:-$HOME/Desktop/skills}"
APM_YML="${APM_YML:-$PWD/apm.yml}"
SKILLS_REPO="https://github.com/phamtanphat/skills.git"
GENERATED_TAG="APM_GENERATED"

# ─── Colors ───────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

info()    { echo -e "${BLUE}ℹ${RESET}  $*"; }
success() { echo -e "${GREEN}✓${RESET}  $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET}  $*"; }
error()   { echo -e "${RED}✗${RESET}  $*" >&2; exit 1; }
dim()     { echo -e "${DIM}   $*${RESET}"; }

# ═══════════════════════════════════════════════════════════════
# DETECT: Project Type
# ═══════════════════════════════════════════════════════════════
detect_project_type() {
  local dir="${1:-$PWD}"
  if [ -f "$dir/pubspec.yaml" ]; then
    echo "flutter"
  elif [ -f "$dir/pyproject.toml" ] || [ -f "$dir/requirements.txt" ] || \
       [ -f "$dir/setup.py" ] || [ -f "$dir/Pipfile" ]; then
    echo "python"
  elif [ -f "$dir/package.json" ]; then
    if grep -q '"next"' "$dir/package.json" 2>/dev/null; then
      echo "nextjs"
    elif grep -q '"react"' "$dir/package.json" 2>/dev/null; then
      echo "react"
    else
      echo "javascript"
    fi
  elif [ -f "$dir/go.mod" ]; then
    echo "go"
  elif [ -f "$dir/Cargo.toml" ]; then
    echo "rust"
  else
    echo "generic"
  fi
}

# ═══════════════════════════════════════════════════════════════
# DETECT: IDEs đang được dùng
# ═══════════════════════════════════════════════════════════════
detect_ides() {
  local ides=()
  command -v claude &>/dev/null || [ -f "$PWD/CLAUDE.md" ] || [ -d "$PWD/.claude" ] && ides+=("claude") || true
  [ -d "$HOME/.cursor" ] || [ -f "$PWD/.cursorrules" ] || [ -d "$PWD/.cursor" ] && ides+=("cursor") || true
  command -v codex &>/dev/null || [ -f "$PWD/AGENTS.md" ] || [ -d "$PWD/.codex" ] && ides+=("codex") || true
  [ -d "$HOME/.codeium" ] || [ -f "$PWD/.windsurfrules" ] || [ -d "$PWD/.windsurf" ] && ides+=("windsurf") || true
  [ -f "$PWD/.github/copilot-instructions.md" ] && ides+=("copilot") || true
  [ -d "$PWD/.vscode" ] && ides+=("vscode") || true
  [ ${#ides[@]} -eq 0 ] && ides+=("claude" "cursor")
  echo "${ides[@]}"
}

# ═══════════════════════════════════════════════════════════════
# CORE: Lấy danh sách skills cho project type
# Trả về: mảng các path tuyệt đối đến skill files
# ═══════════════════════════════════════════════════════════════
get_skill_paths() {
  local project_type="$1"
  local paths=()

  # Skills luôn bật
  paths+=("$SKILLS_DIR/skills/workflow/git-workflow.md")

  # Skills theo loại project
  case "$project_type" in
    flutter)
      paths+=("$SKILLS_DIR/skills/languages/dart/flutter/flutter-code-review.md")
      paths+=("$SKILLS_DIR/skills/architecture/clean-architecture.md")
      paths+=("$SKILLS_DIR/skills/testing/unit-test-guide.md")
      ;;
    python)
      paths+=("$SKILLS_DIR/skills/languages/python/code-review.md")
      paths+=("$SKILLS_DIR/skills/languages/python/fastapi-patterns.md")
      paths+=("$SKILLS_DIR/skills/architecture/clean-architecture.md")
      paths+=("$SKILLS_DIR/skills/testing/unit-test-guide.md")
      ;;
    nextjs|react|javascript)
      paths+=("$SKILLS_DIR/skills/languages/javascript/react-patterns.md")
      paths+=("$SKILLS_DIR/skills/architecture/clean-architecture.md")
      ;;
    go|rust)
      paths+=("$SKILLS_DIR/skills/architecture/clean-architecture.md")
      ;;
    *)
      paths+=("$SKILLS_DIR/skills/architecture/clean-architecture.md")
      ;;
  esac

  # Thêm DevOps nếu có Dockerfile
  [ -f "$PWD/Dockerfile" ] || [ -f "$PWD/docker-compose.yml" ] && \
    paths+=("$SKILLS_DIR/skills/devops/docker-guide.md") || true

  # Thêm CI/CD nếu có GitHub Actions
  [ -d "$PWD/.github/workflows" ] && \
    paths+=("$SKILLS_DIR/skills/devops/cicd-pipeline.md") || true

  for p in "${paths[@]}"; do
    [ -f "$p" ] && echo "$p" || true
  done
}

# ═══════════════════════════════════════════════════════════════
# HELPER: Lấy tên skill từ path (dùng để đặt tên file)
# ═══════════════════════════════════════════════════════════════
skill_name_from_path() {
  basename "$1" .md
}

# ═══════════════════════════════════════════════════════════════
# HELPER: Tạo header APM cho file
# ═══════════════════════════════════════════════════════════════
apm_header() {
  local comment_style="${1:-md}"   # md | hash
  local project_type="$2"
  local ts
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  if [ "$comment_style" = "hash" ]; then
    echo "# ${GENERATED_TAG} — Đừng sửa tay, dùng: apm inject"
    echo "# Source: github.com/phamtanphat/skills | type: $project_type | at: $ts"
  else
    echo "<!-- ${GENERATED_TAG} — Đừng sửa tay, dùng: apm inject -->"
    echo "<!-- Source: github.com/phamtanphat/skills | type: $project_type | at: $ts -->"
  fi
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Claude — CLAUDE.md + .claude/skills/<name>.md
#
# Cấu trúc:
#   CLAUDE.md              ← index file với @imports
#   .claude/
#   └── skills/
#       ├── git-workflow.md
#       ├── flutter-code-review.md
#       └── clean-architecture.md
# ═══════════════════════════════════════════════════════════════
inject_claude() {
  local project_type="$1"
  local skills_out="$PWD/.claude/skills"
  mkdir -p "$skills_out"

  info "Claude → .claude/skills/ + CLAUDE.md"

  # Xóa skills cũ do apm tạo
  find "$skills_out" -name "*.md" -exec grep -l "$GENERATED_TAG" {} \; 2>/dev/null | xargs rm -f 2>/dev/null || true

  local imports=""
  while IFS= read -r skill_path; do
    local name
    name=$(skill_name_from_path "$skill_path")
    local out="$skills_out/${name}.md"

    {
      apm_header "md" "$project_type"
      echo ""
      cat "$skill_path"
    } > "$out"

    imports+="@.claude/skills/${name}.md"$'\n'
    dim "  .claude/skills/${name}.md"
  done < <(get_skill_paths "$project_type")

  # Tạo CLAUDE.md index
  {
    apm_header "md" "$project_type"
    echo ""
    echo "# Claude AI Instructions — $(basename "$PWD")"
    echo ""
    echo "## Skills"
    echo ""
    echo "$imports"
    echo ""
    echo "---"
    echo "_Xem từng skill trong \`.claude/skills/\` để biết chi tiết._"
    echo "_Cấu hình MCP: xem \`apm.yml\`_"
  } > "$PWD/CLAUDE.md"

  success "Claude: CLAUDE.md + .claude/skills/ ($(get_skill_paths "$project_type" | wc -l | tr -d ' ') skills)"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Cursor — .cursor/rules/<name>.mdc (format mới)
#                  + .cursorrules (fallback format cũ)
#
# Cấu trúc:
#   .cursor/
#   └── rules/
#       ├── git-workflow.mdc
#       ├── flutter-code-review.mdc
#       └── clean-architecture.mdc
# ═══════════════════════════════════════════════════════════════
inject_cursor() {
  local project_type="$1"
  local rules_dir="$PWD/.cursor/rules"
  mkdir -p "$rules_dir"

  info "Cursor → .cursor/rules/*.mdc"

  # Xóa rules cũ do apm tạo
  find "$rules_dir" -name "*.mdc" -exec grep -l "$GENERATED_TAG" {} \; 2>/dev/null | xargs rm -f 2>/dev/null || true

  local all_content=""
  while IFS= read -r skill_path; do
    local name
    name=$(skill_name_from_path "$skill_path")
    local out="$rules_dir/${name}.mdc"

    # Cursor .mdc format: YAML frontmatter + markdown body
    {
      echo "---"
      echo "description: $(head -1 "$skill_path" | sed 's/^#* *//')"
      echo "alwaysApply: true"
      echo "# ${GENERATED_TAG} | source: github.com/phamtanphat/skills"
      echo "---"
      echo ""
      cat "$skill_path"
    } > "$out"

    all_content+=$'\n\n---\n\n'
    all_content+=$(cat "$skill_path")

    dim "  .cursor/rules/${name}.mdc"
  done < <(get_skill_paths "$project_type")

  # .cursorrules fallback (legacy Cursor versions)
  {
    apm_header "hash" "$project_type"
    echo ""
    echo "$all_content"
  } > "$PWD/.cursorrules"

  success "Cursor: .cursor/rules/*.mdc + .cursorrules fallback"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Codex / OpenAI — AGENTS.md + .codex/skills/<name>.md
#
# OpenAI Codex CLI đọc AGENTS.md hoặc thư mục .codex/
# Cấu trúc:
#   AGENTS.md              ← index
#   .codex/
#   └── skills/
#       ├── git-workflow.md
#       └── ...
# ═══════════════════════════════════════════════════════════════
inject_codex() {
  local project_type="$1"
  local skills_out="$PWD/.codex/skills"
  mkdir -p "$skills_out"

  info "Codex → .codex/skills/ + AGENTS.md"

  # Xóa skills cũ
  find "$skills_out" -name "*.md" -exec grep -l "$GENERATED_TAG" {} \; 2>/dev/null | xargs rm -f 2>/dev/null || true

  local refs=""
  while IFS= read -r skill_path; do
    local name
    name=$(skill_name_from_path "$skill_path")
    local out="$skills_out/${name}.md"

    {
      apm_header "md" "$project_type"
      echo ""
      cat "$skill_path"
    } > "$out"

    refs+="- [${name}](.codex/skills/${name}.md)"$'\n'
    dim "  .codex/skills/${name}.md"
  done < <(get_skill_paths "$project_type")

  # AGENTS.md index (Codex đọc file này)
  {
    apm_header "md" "$project_type"
    echo ""
    echo "# Agent Instructions — $(basename "$PWD")"
    echo ""
    echo "## Loaded Skills"
    echo ""
    echo "$refs"
    echo ""
    echo "---"
    echo "_Skills được quản lý bởi APM. Xem \`.codex/skills/\` để biết chi tiết._"
  } > "$PWD/AGENTS.md"

  success "Codex: AGENTS.md + .codex/skills/"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: Windsurf — .windsurf/rules/<name>.md + .windsurfrules
#
# Cấu trúc:
#   .windsurf/
#   └── rules/
#       ├── git-workflow.md
#       └── ...
# ═══════════════════════════════════════════════════════════════
inject_windsurf() {
  local project_type="$1"
  local rules_dir="$PWD/.windsurf/rules"
  mkdir -p "$rules_dir"

  info "Windsurf → .windsurf/rules/ + .windsurfrules"

  find "$rules_dir" -name "*.md" -exec grep -l "$GENERATED_TAG" {} \; 2>/dev/null | xargs rm -f 2>/dev/null || true

  local all_content=""
  while IFS= read -r skill_path; do
    local name
    name=$(skill_name_from_path "$skill_path")
    local out="$rules_dir/${name}.md"

    {
      apm_header "md" "$project_type"
      echo ""
      cat "$skill_path"
    } > "$out"

    all_content+=$'\n\n---\n\n'
    all_content+=$(cat "$skill_path")

    dim "  .windsurf/rules/${name}.md"
  done < <(get_skill_paths "$project_type")

  # .windsurfrules fallback
  {
    apm_header "hash" "$project_type"
    echo ""
    echo "$all_content"
  } > "$PWD/.windsurfrules"

  success "Windsurf: .windsurf/rules/ + .windsurfrules fallback"
}

# ═══════════════════════════════════════════════════════════════
# INJECT: GitHub Copilot — .github/copilot-instructions.md
#         + .github/instructions/<name>.instructions.md (VS Code 1.99+)
#
# Cấu trúc:
#   .github/
#   ├── copilot-instructions.md     ← global instructions
#   └── instructions/               ← per-skill (VS Code 1.99+ / Copilot Chat)
#       ├── git-workflow.instructions.md
#       └── ...
# ═══════════════════════════════════════════════════════════════
inject_copilot() {
  local project_type="$1"
  local inst_dir="$PWD/.github/instructions"
  mkdir -p "$inst_dir"
  mkdir -p "$PWD/.github"

  info "Copilot → .github/instructions/*.instructions.md + copilot-instructions.md"

  find "$inst_dir" -name "*.instructions.md" -exec grep -l "$GENERATED_TAG" {} \; 2>/dev/null | xargs rm -f 2>/dev/null || true

  local refs=""
  local all_content=""
  while IFS= read -r skill_path; do
    local name
    name=$(skill_name_from_path "$skill_path")
    local out="$inst_dir/${name}.instructions.md"

    # VS Code Copilot instructions format: frontmatter với applyTo
    {
      echo "---"
      echo "applyTo: '**'"
      echo "# ${GENERATED_TAG} | source: github.com/phamtanphat/skills"
      echo "---"
      echo ""
      cat "$skill_path"
    } > "$out"

    refs+="- [${name}](.github/instructions/${name}.instructions.md)"$'\n'
    all_content+=$'\n\n---\n\n'
    all_content+=$(cat "$skill_path")

    dim "  .github/instructions/${name}.instructions.md"
  done < <(get_skill_paths "$project_type")

  # copilot-instructions.md (global, đọc bởi tất cả Copilot clients)
  {
    apm_header "md" "$project_type"
    echo ""
    echo "# GitHub Copilot Instructions — $(basename "$PWD")"
    echo ""
    echo "## Skills"
    echo "$refs"
    echo ""
    echo "---"
    echo ""
    echo "$all_content"
  } > "$PWD/.github/copilot-instructions.md"

  success "Copilot: .github/instructions/ + copilot-instructions.md"
}

# VSCode reuse Copilot
inject_vscode() { inject_copilot "$1"; }

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm init
# ═══════════════════════════════════════════════════════════════
cmd_init() {
  echo -e "\n${BOLD}${CYAN}APM Init${RESET} — Khởi tạo cho dự án\n"

  [ ! -d "$SKILLS_DIR" ] && \
    error "Skills repo chưa được cài. Chạy install.sh trước."

  local project_type
  project_type=$(detect_project_type "$PWD")
  info "Loại dự án: ${BOLD}$project_type${RESET}"

  if [ -f "$APM_YML" ]; then
    warn "apm.yml đã tồn tại. Dùng 'apm inject' để cập nhật."
    return 0
  fi

  local template="$SKILLS_DIR/templates/${project_type}-project/apm.yml"

  if [ -f "$template" ]; then
    cp "$template" "$APM_YML"
    local proj_name
    proj_name=$(basename "$PWD")
    sed -i.bak "s/my-${project_type}-app/$proj_name/g" "$APM_YML" 2>/dev/null || \
    sed -i "s/my-${project_type}-app/$proj_name/g" "$APM_YML"
    rm -f "$APM_YML.bak"
    success "Đã tạo apm.yml từ template '$project_type'"
  else
    cat > "$APM_YML" << GENERIC_EOF
# apm.yml — $(basename "$PWD")
# Generated by APM — github.com/phamtanphat/skills

name: $(basename "$PWD")
version: 1.0.0

skills:
  - name: git-workflow
    path: $SKILLS_DIR/skills/workflow/git-workflow.md
    activate:
      always: true

  - name: clean-architecture
    path: $SKILLS_DIR/skills/architecture/clean-architecture.md
    activate:
      always: true

mcpServers:
  serena:
    command: uvx
    args:
      - "--from"
      - "git+https://github.com/oraios/serena"
      - "serena"
      - "start-mcp-server"
    transport: stdio

  context7:
    command: npx
    args: ["-y", "@upstash/context7-mcp"]
    transport: stdio
    env:
      CONTEXT7_API_KEY: "ctx7sk-31f118e9-1ca9-4dfc-8a59-4cd58ec0a630"
GENERIC_EOF
    success "Đã tạo apm.yml (generic)"
  fi

  echo ""
  info "Bước tiếp theo:"
  dim "1. Chỉnh apm.yml nếu cần"
  dim "2. apm inject"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm inject
# ═══════════════════════════════════════════════════════════════
cmd_inject() {
  local target_ide="${1:-}"

  echo -e "\n${BOLD}${CYAN}APM Inject${RESET} — Inject skills vào IDE\n"

  [ ! -d "$SKILLS_DIR" ] && error "Skills repo chưa cài. Chạy install.sh trước."

  local project_type
  project_type=$(detect_project_type "$PWD")
  info "Loại dự án: ${BOLD}$project_type${RESET}"

  local ides
  if [ -n "$target_ide" ]; then
    ides=("$target_ide")
  else
    read -ra ides <<< "$(detect_ides)"
    info "IDEs được detect: ${BOLD}${ides[*]}${RESET}"
  fi

  # Hiển thị skills sẽ được inject
  echo ""
  info "Skills sẽ inject:"
  while IFS= read -r p; do
    dim "$(skill_name_from_path "$p")"
  done < <(get_skill_paths "$project_type")
  echo ""

  for ide in "${ides[@]}"; do
    case "$ide" in
      claude|antigravity) inject_claude "$project_type" ;;
      cursor)             inject_cursor "$project_type" ;;
      codex)              inject_codex "$project_type" ;;
      windsurf)           inject_windsurf "$project_type" ;;
      copilot)            inject_copilot "$project_type" ;;
      vscode)             inject_vscode "$project_type" ;;
      *)                  warn "IDE '$ide' không hỗ trợ. Thử: claude, cursor, codex, windsurf, copilot" ;;
    esac
  done

  echo ""
  success "Inject hoàn thành! Skills đã sẵn sàng trong dự án."
  echo ""
  info "Cấu trúc được tạo:"
  dim ".claude/skills/*.md         ← Claude Code"
  dim ".cursor/rules/*.mdc         ← Cursor (new format)"
  dim ".cursorrules                ← Cursor (legacy)"
  dim ".codex/skills/*.md          ← OpenAI Codex"
  dim "AGENTS.md                   ← Codex index"
  dim ".windsurf/rules/*.md        ← Windsurf"
  dim ".github/instructions/*.instructions.md  ← Copilot (VS Code 1.99+)"
  dim ".github/copilot-instructions.md         ← Copilot (all clients)"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm status
# ═══════════════════════════════════════════════════════════════
cmd_status() {
  echo -e "\n${BOLD}${CYAN}APM Status${RESET}\n"

  if [ -d "$SKILLS_DIR/.git" ]; then
    local version
    version=$(git -C "$SKILLS_DIR" log --oneline -1 2>/dev/null | cut -c1-7)
    success "Skills repo: $SKILLS_DIR ${DIM}(commit: $version)${RESET}"
  else
    warn "Skills repo chưa cài tại $SKILLS_DIR"
  fi

  local project_type
  project_type=$(detect_project_type "$PWD")
  info "Project type: ${BOLD}$project_type${RESET}"

  [ -f "$APM_YML" ] && success "apm.yml: $APM_YML" || warn "Chưa có apm.yml — chạy: apm init"

  echo ""
  echo -e "  ${BOLD}IDE Directories & Files:${RESET}"

  # Claude
  local claude_count=0
  [ -d "$PWD/.claude/skills" ] && claude_count=$(find "$PWD/.claude/skills" -name "*.md" | wc -l | tr -d ' ')
  if [ "$claude_count" -gt 0 ]; then
    success "Claude: .claude/skills/ ${DIM}(${claude_count} skills)${RESET}"
  elif [ -f "$PWD/CLAUDE.md" ]; then
    info "Claude: CLAUDE.md ${DIM}(flat file)${RESET}"
  else
    dim "Claude: —"
  fi

  # Cursor
  local cursor_count=0
  [ -d "$PWD/.cursor/rules" ] && cursor_count=$(find "$PWD/.cursor/rules" -name "*.mdc" | wc -l | tr -d ' ')
  if [ "$cursor_count" -gt 0 ]; then
    success "Cursor: .cursor/rules/ ${DIM}(${cursor_count} rules)${RESET} + .cursorrules"
  elif [ -f "$PWD/.cursorrules" ]; then
    info "Cursor: .cursorrules ${DIM}(flat file)${RESET}"
  else
    dim "Cursor: —"
  fi

  # Codex
  local codex_count=0
  [ -d "$PWD/.codex/skills" ] && codex_count=$(find "$PWD/.codex/skills" -name "*.md" | wc -l | tr -d ' ')
  if [ "$codex_count" -gt 0 ]; then
    success "Codex: .codex/skills/ ${DIM}(${codex_count} skills)${RESET} + AGENTS.md"
  elif [ -f "$PWD/AGENTS.md" ] || [ -f "$PWD/codex.md" ]; then
    info "Codex: AGENTS.md ${DIM}(flat file)${RESET}"
  else
    dim "Codex: —"
  fi

  # Windsurf
  local ws_count=0
  [ -d "$PWD/.windsurf/rules" ] && ws_count=$(find "$PWD/.windsurf/rules" -name "*.md" | wc -l | tr -d ' ')
  if [ "$ws_count" -gt 0 ]; then
    success "Windsurf: .windsurf/rules/ ${DIM}(${ws_count} rules)${RESET}"
  elif [ -f "$PWD/.windsurfrules" ]; then
    info "Windsurf: .windsurfrules ${DIM}(flat file)${RESET}"
  else
    dim "Windsurf: —"
  fi

  # Copilot
  local cp_count=0
  [ -d "$PWD/.github/instructions" ] && cp_count=$(find "$PWD/.github/instructions" -name "*.instructions.md" | wc -l | tr -d ' ')
  if [ "$cp_count" -gt 0 ]; then
    success "Copilot: .github/instructions/ ${DIM}(${cp_count} files)${RESET} + copilot-instructions.md"
  elif [ -f "$PWD/.github/copilot-instructions.md" ]; then
    info "Copilot: copilot-instructions.md ${DIM}(flat file)${RESET}"
  else
    dim "Copilot: —"
  fi

  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm update
# ═══════════════════════════════════════════════════════════════
cmd_update() {
  echo -e "\n${BOLD}${CYAN}APM Update${RESET} — Cập nhật Skills Repository\n"
  [ ! -d "$SKILLS_DIR/.git" ] && error "Skills repo chưa cài tại $SKILLS_DIR"
  info "Đang pull từ $SKILLS_REPO..."
  git -C "$SKILLS_DIR" pull origin main
  success "Đã cập nhật! Chạy 'apm inject' để áp dụng vào dự án."
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm list
# ═══════════════════════════════════════════════════════════════
cmd_list() {
  echo -e "\n${BOLD}${CYAN}APM Skills${RESET} — Có sẵn trong $SKILLS_DIR\n"
  [ ! -d "$SKILLS_DIR/skills" ] && error "Skills repo chưa cài."

  find "$SKILLS_DIR/skills" -name "*.md" | sort | while read -r f; do
    echo -e "  ${CYAN}•${RESET} ${f#$SKILLS_DIR/}"
  done
  echo ""
  echo -e "  ${BOLD}Templates:${RESET}"
  find "$SKILLS_DIR/templates" -name "apm.yml" | sort | while read -r f; do
    echo -e "  ${GREEN}→${RESET} $(basename "$(dirname "$f")")"
  done
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: apm help
# ═══════════════════════════════════════════════════════════════
cmd_help() {
  echo ""
  echo -e "${BOLD}${CYAN}APM — AI Package Manager${RESET}"
  echo -e "${DIM}github.com/phamtanphat/skills${RESET}"
  echo ""
  echo -e "${BOLD}USAGE:${RESET}  apm ${CYAN}<command>${RESET} [options]"
  echo ""
  echo -e "${BOLD}COMMANDS:${RESET}"
  echo -e "  ${CYAN}init${RESET}                 Tạo apm.yml (auto-detect project type)"
  echo -e "  ${CYAN}inject${RESET}               Inject skills vào tất cả IDE được detect"
  echo -e "  ${CYAN}inject --ide <n>${RESET}      Inject vào IDE cụ thể"
  echo -e "  ${CYAN}update${RESET}               Cập nhật skills repository từ GitHub"
  echo -e "  ${CYAN}status${RESET}               Xem trạng thái dự án"
  echo -e "  ${CYAN}list${RESET}                 Liệt kê tất cả skills có sẵn"
  echo ""
  echo -e "${BOLD}IDE → DIRECTORIES:${RESET}"
  echo -e "  ${GREEN}claude${RESET}    → CLAUDE.md + ${CYAN}.claude/skills/*.md${RESET}"
  echo -e "  ${GREEN}cursor${RESET}    → .cursorrules + ${CYAN}.cursor/rules/*.mdc${RESET}"
  echo -e "  ${GREEN}codex${RESET}     → AGENTS.md + ${CYAN}.codex/skills/*.md${RESET}"
  echo -e "  ${GREEN}windsurf${RESET}  → .windsurfrules + ${CYAN}.windsurf/rules/*.md${RESET}"
  echo -e "  ${GREEN}copilot${RESET}   → copilot-instructions.md + ${CYAN}.github/instructions/*.instructions.md${RESET}"
  echo ""
  echo -e "${BOLD}EXAMPLES:${RESET}"
  echo -e "  apm init && apm inject"
  echo -e "  apm inject --ide cursor"
  echo -e "  apm inject --ide claude --ide codex"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════
COMMAND="${1:-help}"

case "$COMMAND" in
  init)   cmd_init ;;
  inject)
    shift || true
    IDE_ARG=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --ide) IDE_ARG="${2:-}"; shift 2 ;;
        *)     shift ;;
      esac
    done
    cmd_inject "$IDE_ARG"
    ;;
  update) cmd_update ;;
  status) cmd_status ;;
  list)   cmd_list ;;
  help|--help|-h) cmd_help ;;
  *) error "Command '$COMMAND' không tồn tại. Dùng: apm help" ;;
esac
